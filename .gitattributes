# Shell scripts, Dockerfiles, Makefiles and Python must keep LF line endings on every platform,
# or the oracle and the verifier entry point break in a Windows checkout (review finding F-06).
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
